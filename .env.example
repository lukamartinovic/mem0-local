# mem0-local configuration
# Copy to .env and override as needed

# Ollama LLM model — must support tool calling
# See: https://ollama.com/search?c=tools
MEM0_LLM_MODEL=qwen2.5:7b

# Ollama embedding model
MEM0_EMBED_MODEL=nomic-embed-text

# Embedding dimensions (must match the embedder model)
MEM0_EMBED_DIMS=768

# Ollama URL (host Ollama, reachable from Docker via host.docker.internal)
# MEM0_OLLAMA_URL=http://host.docker.internal:11434

# Qdrant host/port (Docker service name)
# MEM0_QDRANT_HOST=qdrant
# MEM0_QDRANT_PORT=6333

# LLM settings
# MEM0_LLM_TEMPERATURE=0.1
# MEM0_LLM_MAX_TOKENS=2000

# Default user_id for memory operations
MEM0_DEFAULT_USER_ID=dev

# Disable mem0 telemetry (phone-home to PostHog)
# MEM0_TELEMETRY=False