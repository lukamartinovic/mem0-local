# mem0-local configuration (single container, NO extraction LLM)
# Copy to .env and override as needed.
#
# Fact inference is the calling agent's responsibility: extract facts yourself
# and call add_raw_memory once per concise fact. There is no LLM to configure.

# Embedding model (fastembed, runs in-container via ONNX)
# nomic-ai/nomic-embed-text-v1.5 = 768 dims, compatible with collections
# built by earlier versions of this server.
MEM0_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5

# Embedding dimensions (must match the embedder model AND the stored collection)
MEM0_EMBED_DIMS=768

# Verbatim-storage chunk size in chars (applies to add_verbatim + import_docs)
# MEM0_CHUNK_CHARS=3000

# Qdrant (runs inside the same container; defaults below are correct)
# MEM0_QDRANT_HOST=127.0.0.1
# MEM0_QDRANT_PORT=6333

# Default user_id for memory operations
MEM0_DEFAULT_USER_ID=dev

# Disable mem0 telemetry (phone-home to PostHog) - also forced False in compose
# MEM0_TELEMETRY=False