# mem0-local configuration
# Copy to .env and override as needed

# Ollama LLM model — must support tool calling
# See: https://ollama.com/search?c=tools
MEM0_LLM_MODEL=qwen2.5:7b

# Ollama embedding model
MEM0_EMBED_MODEL=nomic-embed-text

# Embedding dimensions (must match the embedder model)
MEM0_EMBED_DIMS=768

# Ollama URL — two modes:
#
# 1. Local (default): Ollama runs on your machine with Metal GPU acceleration.
#    Leave commented out — setup.sh uses host.docker.internal automatically.
#
# 2. External: Ollama runs elsewhere (company VPN, remote server, cloud).
#    Set the URL here. setup.sh detects this and skips local Ollama install.
#    Models must be pre-pulled on the remote Ollama instance.
#
# MEM0_OLLAMA_URL=https://ollama.internal.company.com
# MEM0_OLLAMA_URL=http://10.0.0.50:11434

# Qdrant host/port (Docker service name)
# MEM0_QDRANT_HOST=qdrant
# MEM0_QDRANT_PORT=6333

# LLM settings
# MEM0_LLM_TEMPERATURE=0.1
# MEM0_LLM_MAX_TOKENS=4000

# Default user_id for memory operations
MEM0_DEFAULT_USER_ID=dev

# Disable mem0 telemetry (phone-home to PostHog)
# MEM0_TELEMETRY=False

# Custom extraction instructions — controls what the LLM extracts from content.
# Defaults to software engineering focus (architecture, tech choices, APIs, etc.)
# Set to empty string to use mem0's default (general personal information)
# MEM0_CUSTOM_INSTRUCTIONS=